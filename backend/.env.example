# Copy to backend/.env for local docker-compose use. Never commit the real file.

DATABASE_URL=postgresql+psycopg://billwise:billwise_dev_password@db:5432/billwise
TEST_DATABASE_URL=postgresql+psycopg://billwise:billwise_dev_password@db:5432/billwise_test

# Generate a real secret for anything beyond local dev, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-value

COOKIE_SECURE=false
FRONTEND_BASE_URL=http://localhost:3000

# Required for receipt OCR structuring (M5) — get one at https://console.anthropic.com/.
# Without it, POST /ocr/receipt returns 503 and the frontend falls back to manual entry.
ANTHROPIC_API_KEY=
