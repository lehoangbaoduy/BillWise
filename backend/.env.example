# Copy to backend/.env for local docker-compose use. Never commit the real file.

DATABASE_URL=postgresql+psycopg://billwise:billwise_dev_password@db:5432/billwise
TEST_DATABASE_URL=postgresql+psycopg://billwise:billwise_dev_password@db:5432/billwise_test

# REQUIRED before any shared or internet-facing deployment: replace this with
# a real random value. The app logs a startup warning if it detects the
# checked-in placeholder — every session token is forgeable by anyone who has
# read this repo until you do. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# See DEPLOYMENT.md for the full pre-deploy checklist.
SECRET_KEY=change-me-to-a-random-value

COOKIE_SECURE=false
# lax works for local dev and same-registrable-domain deployments. If your
# frontend and backend end up on different registrable domains in production
# (e.g. a Vercel frontend calling a Render/Fly/Railway backend), set this to
# "none" AND set COOKIE_SECURE=true — browsers never attach a Lax cookie to
# cross-site fetch/XHR, only to top-level navigations, so auth silently
# breaks past login otherwise. See DEPLOYMENT.md.
COOKIE_SAMESITE=lax
FRONTEND_BASE_URL=http://localhost:3000

# Required for receipt OCR structuring (M5) — get one at https://console.anthropic.com/.
# Without it, POST /ocr/receipt returns 503 and the frontend falls back to manual entry.
ANTHROPIC_API_KEY=
