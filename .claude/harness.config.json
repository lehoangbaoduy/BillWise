{
  "specPrefix": "BIW",
  "gatedGlobs": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exemptGlobs": [
    "**/*.md",
    "**/*.lock",
    "**/package-lock.json",
    "**/*.json"
  ],
  "testGlobs": [
    "**/*.test.ts",
    "**/*.spec.ts"
  ],
  "testCommands": [
    {
      "globs": [
        "**/*.py"
      ],
      "command": "pytest"
    },
    {
      "globs": [
        "**/*.ts",
        "**/*.tsx"
      ],
      "command": "npm test"
    }
  ]
}
